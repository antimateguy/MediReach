# MediReach configuration. Every variable is optional: the defaults in
# medireach/config.py work on a clean clone. There are no secrets here because
# the project uses a local SQLite file, not a database server.
#
# These are plain environment variables. Set them in your shell before running:
#   PowerShell:  $env:MEDIREACH_CALL_SHARE = "0.15"
#   bash:        export MEDIREACH_CALL_SHARE=0.15

# Paths (relative paths are resolved against the project root)
MEDIREACH_RAW_CSV=data/raw/KaggleV2-May-2016.csv
MEDIREACH_DB_PATH=data/medireach.db
MEDIREACH_MODELS_DIR=models
MEDIREACH_ARTIFACTS_DIR=artifacts

# Reproducibility
MEDIREACH_SEED=42

# Capacity policy: share of each day's appointments that get a call / an SMS
MEDIREACH_CALL_SHARE=0.10
MEDIREACH_SMS_SHARE=0.20

# Logging level: DEBUG, INFO, WARNING, ERROR
MEDIREACH_LOG_LEVEL=INFO

# Live replay
MEDIREACH_OPS_DB_PATH=data/ops.db
MEDIREACH_TIMEZONE=Asia/Kolkata
MEDIREACH_PLAN_HOUR=8
# Optional fixed "now" in clinic time, for demos at night or on weekends (leave empty for the real clock)
MEDIREACH_DEMO_NOW=

# Demo logins (admin, reception1, reception2) share this password. Demo-grade only.
MEDIREACH_DEMO_PASSWORD=medireach-demo

# AI text on the free Gemini tier (optional). Put the key itself in secrets.toml
# (see secrets.toml.example) or in a GEMINI_API_KEY environment variable, never here.
MEDIREACH_GEMINI_MODEL=gemini-flash-lite-latest
MEDIREACH_GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
MEDIREACH_GEMINI_TIMEOUT=60

# Web app (python -m medireach.web). Bind address and port; hosts usually set PORT themselves.
MEDIREACH_HOST=127.0.0.1
PORT=8000
# Signs the login cookie (at least 16 characters). Leave empty for a random one per start:
# that is fine locally, but everyone is logged out when the server restarts.
MEDIREACH_SESSION_SECRET=
# Split deployment only: the address of the separately hosted frontend (e.g. Cloudflare Pages) that may call
# this API. Comma-separated; leave empty when the API also serves the frontend (local runs, Docker).
MEDIREACH_CORS_ORIGINS=
