# Copy this file to secrets.toml (git-ignored) and paste your key below.
# Get a free key at Google AI Studio -> "Get API key". Do not enable billing on that project.
# On a host, set a GEMINI_API_KEY secret / environment variable instead of using this file.
# Read by the AI briefing and call-script features. Without a key the app uses templates.
GEMINI_API_KEY = "paste-your-key-here"
